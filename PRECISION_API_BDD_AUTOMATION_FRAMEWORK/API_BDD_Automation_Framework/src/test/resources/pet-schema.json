{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet Schema",
  "type": "object",

  "required": ["id", "name", "status"],

  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["available", "pending", "sold"]
    },

    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },

    "photoUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}